{
  "name": "@marcatopartners/timezone-enum",
  "version": "0.0.6",
  "description": "Lightweight timezone enum for JavaScript or TypeScript.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:markers",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.json",
    "build:markers": "node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}, null, 2)); require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}, null, 2));\""
  },
  "keywords": [
    "timezones"
  ],
  "author": "Jon Oropeza",
  "license": "MIT",
  "prepublish": "tsc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcato-Partners/timezone-enum.git"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.5.3"
  }
}
